{
  "name": "@nano133/nanoterra",
  "version": "0.5.0",
  "description": "Nanoterra for a creator's game, in one package: the player's sign-in ticket, the player's character (a toon body on the island's skeleton) and the looks ladder.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./character": { "types": "./dist/character/index.d.ts", "import": "./dist/character/index.js" },
    "./character/record": { "types": "./dist/character/pure.d.ts", "import": "./dist/character/pure.js" },
    "./ticket": { "types": "./dist/ticket/index.d.ts", "import": "./dist/ticket/index.js" },
    "./looks": { "types": "./dist/looks/index.d.ts", "import": "./dist/looks/index.js" },
    "./model": { "types": "./dist/model/index.d.ts", "import": "./dist/model/index.js" },
    "./input": { "types": "./dist/input/index.d.ts", "import": "./dist/input/index.js" },
    "./admin": { "types": "./dist/admin/index.d.ts", "import": "./dist/admin/index.js" },
    "./admin/conformance": { "types": "./dist/admin/conformance.d.ts", "import": "./dist/admin/conformance.js" },
    "./admin/d1": { "types": "./dist/admin/adapters/d1.d.ts", "import": "./dist/admin/adapters/d1.js" },
    "./admin/firestore": { "types": "./dist/admin/adapters/firestore.d.ts", "import": "./dist/admin/adapters/firestore.js" },
    "./admin/panel": { "types": "./dist/admin/panel/index.d.ts", "import": "./dist/admin/panel/index.js" },
    "./admin/style.css": "./src/admin/panel/style.css"
  },
  "sideEffects": false,
  "files": ["dist", "src", "README.md", "CHANGELOG.md", "LICENSE", "ai"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": { "three": ">=0.174.0" },
  "peerDependenciesMeta": { "three": { "optional": true } },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.6",
    "three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nano133-com/kit.git",
    "directory": "packages/nanoterra"
  },
  "homepage": "https://nano133.com/build/nanoterra",
  "license": "MIT",
  "keywords": ["nano", "gltf", "glb", "model check", "xno", "nanoterra", "sign in", "ticket", "character", "avatar", "three", "three.js", "toon", "looks", "cosmetics"]
}
