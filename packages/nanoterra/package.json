  "sideEffects": false,
  "files": ["dist", "src", "README.md", "CHANGELOG.md", "LICENSE", "ai"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": { "three": ">=0.174.0", "@nano133/signin": "^0.5.0" },
  "peerDependenciesMeta": { "three": { "optional": true }, "@nano133/signin": { "optional": true } },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.6",
    "three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nano133-com/kit.git",
    "directory": "packages/nanoterra"
  },
  "homepage": "https://nano133.com/build/nanoterra",
  "license": "MIT",
  "keywords": ["nano", "gltf", "glb", "model check", "xno", "nanoterra", "sign in", "ticket", "character", "avatar", "three", "three.js", "toon", "looks", "cosmetics", "friends", "friends list", "options", "settings", "options menu", "emotes", "emote wheel", "passkey", "webauthn", "berry wallet", "nautilus", "nanchat", "shop", "pay", "qr code"]
