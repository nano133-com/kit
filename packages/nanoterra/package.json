{
  "name": "@nano133/nanoterra",
  "version": "0.8.1",
  "description": "Nanoterra for a creator's game, in one package: the player's sign-in ticket, the player's character (a toon body on the island's skeleton), the looks ladder, the admin, the friends list, an options menu, emotes, the player's sign-in (a passkey or a wallet app) and a shop that sells looks for Nano with no key on the server.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./character": { "types": "./dist/character/index.d.ts", "import": "./dist/character/index.js" },
    "./character/record": { "types": "./dist/character/pure.d.ts", "import": "./dist/character/pure.js" },
    "./ticket": { "types": "./dist/ticket/index.d.ts", "import": "./dist/ticket/index.js" },
