{
  "name": "@nano133/looks",
  "version": "0.1.0",
  "description": "The looks of a Nanoterra game: the rules of looks.json, the price ladder, and what a change does to players who own a look. No dependencies; runs in a Worker, a browser and Node.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "sideEffects": false,
  "files": ["dist", "src", "README.md", "CHANGELOG.md", "LICENSE", "ai"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nano133-com/kit.git",
    "directory": "packages/looks"
  },
  "homepage": "https://nano133.com/build/cosmetics",
  "license": "MIT",
  "keywords": ["nano", "xno", "nanoterra", "cosmetics", "looks", "game", "price ladder"]
}
