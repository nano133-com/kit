{
  "name": "@nano133/signin",
  "version": "0.4.0",
  "description": "Sign in with Nano (XNO): a passkey purse, Berry Wallet, Nautilus or NanChat, or any wallet that signs. No payment, no password, no email.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    },
    "./signature": {
      "types": "./dist/signature.d.ts",
      "import": "./dist/signature.js"
    },
    "./message": {
      "types": "./dist/message.d.ts",
      "import": "./dist/message.js"
    },
    "./nautilus": {
      "types": "./dist/nautilus.d.ts",
      "import": "./dist/nautilus.js"
    },
    "./nanchat": {
      "types": "./dist/nanchat.d.ts",
      "import": "./dist/nanchat.js"
    },
    "./nanosignin": {
      "types": "./dist/nanosignin.d.ts",
      "import": "./dist/nanosignin.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./firestore": {
      "types": "./dist/firestore.d.ts",
      "import": "./dist/firestore.js"
    },
    "./passkey": {
      "types": "./dist/passkey.d.ts",
      "import": "./dist/passkey.js"
    },
    "./purse": {
      "types": "./dist/purse.d.ts",
      "import": "./dist/purse.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "ai"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "nanocurrency-web": "^2.0.0"
  },
  "peerDependencies": {
    "firebase-admin": ">=12"
  },
  "peerDependenciesMeta": {
    "firebase-admin": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nano133-com/kit.git",
    "directory": "packages/signin"
  },
  "homepage": "https://nano133.com/build/sign-in-with-nano",
  "license": "MIT",
  "keywords": [
    "nano",
    "xno",
    "login",
    "sign in",
    "authentication",
    "cryptocurrency",
    "passkey",
    "nautilus",
    "nanchat",
    "berry wallet",
    "webauthn"
  ]
}
